PORT=3009
## Choose provider automatically or set explicitly: openai | openrouter | ollama
# LLM_PROVIDER=

# OpenAI (global)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# OpenRouter (global)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Web search (optional, improves quality)
# SERPER_API_KEY=

# OCR for image questions (optional)
# Configure an OCR provider like OCR.Space; used when you upload screenshots/pictures.
# OCR_SPACE_API_KEY=

# GitHub personal access token (optional; for GitHub API calls)
# Never commit the real token — keep it only in .env
# GITHUB_TOKEN=
